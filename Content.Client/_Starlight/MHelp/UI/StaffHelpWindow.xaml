<controls:StaffHelpWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Starlight.MHelp.UI"
    Title="{Loc 'mentor-anm'}">
    <BoxContainer Orientation="Vertical">
        <RichTextLabel Text="{Loc 'mentor-ahelp-bio'}" />
        <Button Name="AdminHelpButton" Access="Public" Text="{Loc 'mentor-ahelp'}" StyleClasses="OpenBoth" />
        <RichTextLabel Text="{Loc 'mentor-mhelp-bio'}" Margin="0 20 0 0" />
        <Button Name="MentorHelpButton" Access="Public" Text="{Loc 'mentor-mhelp'}" StyleClasses="OpenBoth" />
    </BoxContainer>
</controls:StaffHelpWindow>