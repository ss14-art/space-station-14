ent-CartridgePistolFMJ = патрон (.35 авто оболочечный)
    .desc = { ent-BaseCartridgePistol.desc }
ent-CartridgePistolAP = патрон (.35 авто бронебойный)
    .desc = { ent-BaseCartridgePistol.desc }
ent-CartridgePistolPractice = патрон (.35 авто учебный)
    .desc = Пожалуй, самый популярный калибр на рынке, используемый всевозможными пистолетами и пистолетами-пулеметами. Учебные боеприпасы стреляют меловым снарядом, который немного жалит, но в остальном не причиняет никаких длительных повреждений.
ent-CartridgePistolIncendiary = патрон (.35 авто зажигательный)
    .desc = Пожалуй, самый популярный калибр на рынке, используемый всевозможными пистолетами и пистолетами-пулеметами. Зажигательные боеприпасы содержат самовоспламеняющийся состав, который поджигает цели.
ent-CartridgePistolUranium = патрон (.35 авто урановый)
    .desc = Пожалуй, самый популярный калибр на рынке, используемый всевозможными пистолетами и пистолетами-пулеметами. В урановых боеприпасах свинцовый сердечник пули заменен делящимся материалом, облучающим цели изнутри.
ent-CartridgePistolSpent = патрон (.35 авто)
    .suffix = гильза
    .desc = { ent-BaseCartridgePistol.desc }
