ent-BaseMeleeWeaponEnergy = { ent-BaseItem }
    .desc = { ent-BaseItem.desc }
ent-EnergySword = энергетический меч
    .desc = Очень громкий и опасный меч с клинком из чистой концентрированной плазмы. Прорезает небронированные цели как масло.
ent-EnergyDaggerLoud = энергетический кинжал
    .desc = Не такой громкий и опасный кинжал с клинком из чистой концентрированной плазмы. Этот абсолютно не замаскирован.
ent-EnergyDagger = ручка
    .suffix = Э-кинжал
    .desc = Темная чернильная ручка.
ent-EnergyDaggerBox = коробка с э-кинжалом
    .suffix = Э-кинжал
    .desc = Небольшая коробка с э-кинжалом внутри. Упаковка распадается при открытии, не оставляя никаких следов.
ent-EnergyCutlass = энергетическая абордажная сабля
    .desc = Экзотическое энергетическое оружие.
ent-EnergySwordDouble = двухклинковый энергетический меч
    .desc = Интерны Командования Синдиката решили, что одного лезвия на энергетическом мече недостаточно. Его можно хранить в карманах.
ent-HyperEutacticBlade = гиперэвтектический клинок
    .desc = Сверхмассивное оружие, задуманное для того, чтобы разрезать саму ткань пространства и времени надвое, гиперэвтектический клинок динамически формирует гиперэвтектическую кристаллическую наноструктуру, способную проходить сквозь большинство известных форм материи, как горячий нож сквозь масло.
ent-CyborgEnergySword = { ent-EnergySword }
    .suffix = Для киборгов
    .desc = Очень громкий и опасный меч с клинком из чистой концентрированной плазмы. Специально разработан для киборгов синдиката.
ent-CyborgEnergySwordDouble = { ent-EnergySwordDouble }
    .suffix = Одноручный, Для киборгов
    .desc = Интерны Командования Синдиката решили, что одного лезвия на энергетическом мече недостаточно. Специально разработан для киборгов синдиката.
ent-EnergyDaggerLoudBlue = { ent-EnergyDaggerLoud }
    .suffix = синий
    .desc = { ent-EnergyDaggerLoud.desc }
