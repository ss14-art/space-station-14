ent-DisposalPipeBase = { "" }
    .desc = { "" }
ent-DisposalHolder = держатель утилизации
    .desc = { "" }
ent-DisposalPipeBroken = сломанная утилизационная труба
    .desc = БСТ (большая сломанная труба).
ent-DisposalPipe = сегмент утилизационной трубы
    .desc = Огромный сегмент трубы, используемый для строительства систем утилизации.
ent-DisposalTagger = маркировщик утилизационной трубы
    .desc = Труба, маркирующая сущности для маршрутизации.
ent-DisposalSignaller = сигнализатор утилизации
    .desc = Труба, подающая сигнал при прохождении предмета через нее.
ent-DisposalTrunk = ствол утилизации
    .desc = Ствол трубы, используемый в качестве точки входа в системы утилизации.
ent-DisposalRouter = маршрутизатор утилизации
    .desc = Утилизационная труба, способная фильтровать предметы на основе меток. Предметы, поступающие с выходов, не фильтруются и отправляются на вход.
ent-DisposalRouterFlipped = { ent-DisposalRouter }
    .suffix = отраженный
    .desc = { ent-DisposalRouter.desc }
ent-DisposalJunction = утилизационный соединитель 2-1
    .desc = Соединяет 2 трубы в одну. Предметы, поступающие с выхода, движутся прямо.
ent-DisposalJunctionFlipped = { ent-DisposalJunction }
    .desc = Соединяет 2 трубы в одну. Предметы, поступающие с выхода, движутся прямо.
    .suffix = отраженный
ent-DisposalYJunction = утилизационный соединитель 2-1 (альт.)
    .desc = Соединяет 2 трубы сбоку в одну. Предметы, поступающие с выхода, выходят через правый вход.
ent-DisposalXJunction = утилизационный соединитель 3-1
    .desc = Соединяет 3 трубы в одну. Предметы, поступающие с выхода, движутся прямо.
ent-DisposalBend = утилизационный изгиб
    .desc = Труба, изогнутая под углом 90 градусов.
ent-DisposalSignalRouter = сигнальный маршрутизатор утилизации
    .desc = Трехходовой маршрутизатор, управляемый сигналом.
ent-DisposalSignalRouterFlipped = { ent-DisposalSignalRouter }
    .suffix = отраженный
    .desc = { ent-DisposalSignalRouter.desc }
